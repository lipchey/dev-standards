#!/usr/bin/env bash
set -euo pipefail

# verify — shim over the dev-standards verify-runner (built inside the submodule).
# Guards the build-on-demand bundle: if it is missing, point at the bootstrap.

REPO_ROOT="$(CDPATH= cd "$(dirname "$0")/.." && pwd -P)"
BUNDLE="${REPO_ROOT}/vendor/dev-standards/runner/dist/verify-runner.mjs"

# Every gate below refuses BEFORE the runner is reached, so the runner cannot write the terminal
# record for it and a reader grepping for the verdict finds nothing at all. A wrapper owns the
# record for the faults only it can see — grammar and vocabulary: runner/src/verify-runner.ts.
# The `exec` at the bottom replaces this process, so once the runner starts the record is
# entirely its own; that is why nothing here needs to guess at a dispatched run's outcome.
VERIFY_TIER_SCOPE=""
VERIFY_SCOPE_COUNT=0
VERIFY_NO_VERDICT_REASON=""
for ARGUMENT in "$@"; do
  case "${ARGUMENT}" in
    --full | --fast | --audit | --staged)
      VERIFY_TIER_SCOPE="${ARGUMENT#--}"
      VERIFY_SCOPE_COUNT=$((VERIFY_SCOPE_COUNT + 1))
      ;;
    # Counted, never named: neither is a tier, so neither has a verdict to be missing.
    --fix-staged | --doctor) VERIFY_SCOPE_COUNT=$((VERIFY_SCOPE_COUNT + 1)) ;;
  esac
done
# Two scope flags have no single truthful scope; the runner rejects the invocation by name.
if [[ "${VERIFY_SCOPE_COUNT}" -gt 1 ]]; then
  VERIFY_TIER_SCOPE=""
fi

verify_on_exit() {
  local verify_status=$?
  trap - EXIT
  # `set -e` is off for the rest of this handler: a failing printf must not abort before the
  # `exit` below, or the run reports printf's status instead of the one just captured.
  set +e
  # `exec` replaces this process, so REACHING this handler at all means the runner never started
  # and every non-zero exit here is a fault only the wrapper can see. Hence the fallback: a gate
  # that named itself is reported precisely, and anything else — a failed substitution under
  # `set -e`, an unexecutable bundle — still leaves a record instead of a silent status.
  if [[ -n "${VERIFY_TIER_SCOPE}" && "${verify_status}" -ne 0 ]]; then
    printf 'VERIFY RESULT: scope=%s outcome=no-verdict reason=%s\n' \
      "${VERIFY_TIER_SCOPE}" "${VERIFY_NO_VERDICT_REASON:-exit-${verify_status}}" >&2
  fi
  exit "${verify_status}"
}
trap verify_on_exit EXIT

if [[ ! -f "${BUNDLE}" ]]; then
  VERIFY_NO_VERDICT_REASON=bundle-missing
  echo "verify-runner bundle not found at ${BUNDLE}." >&2
  echo "Run: scripts/ds-bootstrap.sh" >&2
  exit 127
fi

# git that ignores the GIT_DIR/index env `git commit` exports to its hooks: inside a
# hook the inherited (absolute, in a linked worktree) GIT_DIR makes `git -C <submodule>`
# ignore the -C path and answer for the SUPERPROJECT, so the staleness check below would
# wrongly compare the bundle stamp to the superproject HEAD. Unsetting the location env
# forces each git call to rediscover the repo from its own -C path (hook-safe).
git_clean() { env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_COMMON_DIR -u GIT_OBJECT_DIRECTORY git "$@"; }

# Reject bundles built for a different submodule revision than the one checked
# out: dist/ is gitignored, so a pin bump leaves stale bundles in place and the
# existence check above would happily run old runner code. ds-bootstrap.sh
# stamps dist/.built-from with the commit it built from.
STAMP="${REPO_ROOT}/vendor/dev-standards/runner/dist/.built-from"
BUILT_FROM="$(cat "${STAMP}" 2>/dev/null || echo none)"
PINNED="$(git_clean -C "${REPO_ROOT}/vendor/dev-standards" rev-parse HEAD 2>/dev/null || echo unknown)"
if [[ "${BUILT_FROM}" != "${PINNED}" ]]; then
  VERIFY_NO_VERDICT_REASON=bundle-stale
  echo "verify-runner bundle is stale: built from ${BUILT_FROM}, submodule now at ${PINNED}." >&2
  echo "Run: scripts/ds-bootstrap.sh" >&2
  exit 127
fi

# Checkout-vs-stamp equality alone misses a pulled pin bump: after `git pull`
# the recorded gitlink moves while the submodule checkout and stamp both stay
# on the old revision and still match each other. Compare against the index
# gitlink (not HEAD's) so an in-progress staged bump validates too. Anything
# but exactly one clean gitlink entry (staged deletion, merge conflict) is
# itself a broken pin state — fail rather than skip the comparison.
RECORDED_ENTRY="$(git_clean -C "${REPO_ROOT}" ls-files -s -- vendor/dev-standards)"
RECORDED_MODE="$(awk '{print $1}' <<<"${RECORDED_ENTRY}")"
RECORDED="$(awk '{print $2}' <<<"${RECORDED_ENTRY}")"
if [[ "${RECORDED_MODE}" != "160000" || "${RECORDED}" != "${PINNED}" ]]; then
  VERIFY_NO_VERDICT_REASON=bundle-pin-mismatch
  echo "submodule checkout ${PINNED} does not match the recorded pin ${RECORDED:-<none>}." >&2
  echo "Run: scripts/ds-bootstrap.sh" >&2
  exit 127
fi

exec node "${BUNDLE}" --manifest "${REPO_ROOT}/quality.json" "$@"
