{
  "version": 1,
  "repo": "__DS_REPO_NAME__",
  "stack": "meta-docs",
  "scheduler_class": "local-only",
  "budgets": {
    "staged_seconds": 60,
    "fast_seconds": 120,
    "full_seconds": 300,
    "audit_seconds": 60
  },
  "policy": {
    "mutates_by_default": false,
    "format_fix_staged_allowed": false,
    "typed_eslint_in_precommit": false,
    "block_new_dead_code_only": true
  },
  "paths": {
    "reports": ".artifacts/reports/quality",
    "baselines": ".artifacts/quality-baselines"
  },
  "generated": {
    "hooks_dir": ".githooks"
  },
  "workspaces": [
    {
      "name": "root",
      "path": ".",
      "stack": "meta-docs",
      "package_manager": "none"
    }
  ],
  "filesets": [
    {
      "name": "manifests_staged",
      "source": "git_staged",
      "include": ["**/package.json", "package-lock.json", "pnpm-lock.yaml", "pnpm-workspace.yaml"]
    }
  ],
  "tiers": {
    "staged": [
      {
        "name": "check-new-deps",
        "argv": ["node", "vendor/dev-standards/tools/check-new-deps.mjs"],
        "mode": "report-only",
        "operational_exit_codes": [2],
        "skip_if_empty": "manifests_staged",
        "timeout_seconds": 10
      }
    ],
    "fast": [
      {
        "name": "instance-docs-seeded",
        "argv": [
          "vendor/dev-standards/scripts/seed-review-guides.sh",
          ".",
          "--check"
        ],
        "timeout_seconds": 10
      }
    ],
    "full": [
      {
        "name": "instance-docs-seeded",
        "argv": [
          "vendor/dev-standards/scripts/seed-review-guides.sh",
          ".",
          "--check"
        ],
        "timeout_seconds": 10
      }
    ],
    "audit": []
  },
  "deep_review": {
    "enabled": true,
    "modes": [
      "review-only",
      "review-and-refactor"
    ],
    "budget": {
      "seconds": 1800
    },
    "guides_dir": ".claude/review-guides",
    "no_touch_globs_ref": ".claude/project-facts.md",
    "verify_after_fix": "--full",
    "verify_entry": "scripts/verify",
    "required_reads": [
      ".claude/project-facts.md",
      ".claude/code-conventions.md",
      ".claude/CHECKLIST.md"
    ]
  }
}
