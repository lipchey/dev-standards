{
  "version": 1,
  "repo": "dev-standards",
  "stack": "node-service",
  "scheduler_class": "local-only",
  "budgets": {
    "staged_seconds": 15,
    "fast_seconds": 150,
    "full_seconds": 420,
    "audit_seconds": 300
  },
  "policy": {
    "mutates_by_default": false,
    "format_fix_staged_allowed": false,
    "typed_eslint_in_precommit": false,
    "block_new_dead_code_only": true
  },
  "paths": {
    "reports": "reports/quality",
    "baselines": "quality-baselines"
  },
  "generated": {
    "hooks_dir": ".githooks"
  },
  "workspaces": [
    {
      "name": "root",
      "path": ".",
      "stack": "node-service",
      "package_manager": "npm"
    }
  ],
  "filesets": [
    {
      "name": "repo_ts",
      "source": "repo_all",
      "include": ["runner/src/**/*.ts", "tests/**/*.ts"],
      "exclude": []
    },
    {
      "name": "manifests_staged",
      "source": "git_staged",
      "include": ["package.json", "package-lock.json"]
    },
    {
      "name": "placement_tree",
      "source": "repo_all",
      "include": ["tests/**", "runner/src/**", "tools/**", "scripts/**", "deep-review/src/**", "eslint/**"],
      "exclude": []
    }
  ],
  "tiers": {
    "staged": [],
    "fast": [
      {
        "name": "runner-typecheck",
        "argv": ["npm", "run", "typecheck"],
        "timeout_seconds": 15
      },
      {
        "name": "runner-tests",
        "argv": ["npm", "run", "test:runner"],
        "timeout_seconds": 60
      },
      {
        "name": "check-new-deps",
        "argv": ["node", "tools/check-new-deps.mjs"],
        "mode": "report-only",
        "operational_exit_codes": [2],
        "skip_if_empty": "manifests_staged",
        "timeout_seconds": 10
      },
      {
        "name": "eslint",
        "argv": ["npm", "run", "lint"],
        "operational_exit_codes": [2],
        "timeout_seconds": 45
      }
    ],
    "full": [
      {
        "name": "runner-typecheck",
        "argv": ["npm", "run", "typecheck"],
        "timeout_seconds": 60
      },
      {
        "name": "full-tests",
        "argv": ["npm", "test"],
        "timeout_seconds": 60
      },
      {
        "name": "runner-build",
        "argv": ["npm", "run", "build"],
        "timeout_seconds": 60
      },
      {
        "name": "deep-review-e2e",
        "argv": ["npm", "run", "test:e2e"],
        "timeout_seconds": 45
      },
      {
        "name": "eslint",
        "argv": ["npm", "run", "lint"],
        "operational_exit_codes": [2],
        "timeout_seconds": 45
      },
      {
        "name": "knip",
        "argv": ["npm", "run", "knip"],
        "mode": "report-only",
        "timeout_seconds": 60
      },
      {
        "name": "check-test-placement",
        "argv": [
          "node", "tools/check-test-placement.mjs",
          "--map", "tests/runner:runner/src:.ts",
          "--map", "tests/tools:tools:.mjs",
          "--map", "tests/tools:scripts:.sh",
          "--map", "tests/tools:scripts:.mjs",
          "--map", "tests/deep-review:deep-review/src:.ts",
          "--map", "tests/eslint:eslint:.js",
          "--ignore", "tests/deep-review-e2e/**",
          "--ignore", "tests/fixtures/**",
          "--ignore", "tests/eslint/fixtures/**",
          "--ignore", "tests/deep-review/slug.test.ts",
          "--ignore", "tests/deep-review/verify-state.test.ts",
          "--ignore", "tests/eslint/presets.test.mjs",
          "--ignore", "tests/eslint/presets-compose.test.mjs",
          "--ignore", "tests/runner/build-freshness.test.ts",
          "--ignore", "tests/runner/cli-scope-prototype.test.ts",
          "--ignore", "tests/runner/fixtures.test.ts",
          "--ignore", "tests/runner/manifest-conformance.bugfix.test.ts",
          "--ignore", "tests/runner/review-guides-present.test.ts",
          "--ignore", "tests/runner/skill-wrappers-static.test.ts",
          "--ignore", "tests/runner/validate-cli.test.ts",
          "--ignore", "tests/runner/validate-diff-filter.test.ts",
          "--ignore", "tests/tools/glob-conformance.test.ts",
          "--", "{files:placement_tree}"
        ],
        "mode": "report-only",
        "operational_exit_codes": [2],
        "timeout_seconds": 15
      }
    ],
    "audit": []
  }
}
