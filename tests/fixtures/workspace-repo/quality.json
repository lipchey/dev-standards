{
  "version": 1,
  "repo": "fixture-workspace-repo",
  "stack": "node-service",
  "scheduler_class": "local-only",
  "budgets": { "staged_seconds": 10, "fast_seconds": 20, "full_seconds": 30, "audit_seconds": 30 },
  "policy": { "mutates_by_default": false, "format_fix_staged_allowed": false, "typed_eslint_in_precommit": false, "block_new_dead_code_only": true },
  "paths": { "reports": "reports/quality", "baselines": "quality-baselines" },
  "generated": { "hooks_dir": ".githooks" },
  "workspaces": [
    { "name": "api", "path": "packages/api", "stack": "node-service", "package_manager": "npm" },
    { "name": "web", "path": "packages/web", "stack": "frontend-web", "package_manager": "npm" }
  ],
  "filesets": [ { "name": "repo_sources", "source": "repo_all", "include": ["packages/**/*.ts", "packages/**/*.tsx"], "exclude": [] } ],
  "tiers": {
    "staged": [],
    "fast": [
      { "name": "ok", "argv": ["node", "../../stubs/ok.mjs"], "timeout_seconds": 5 },
      { "name": "echo-files", "argv": ["node", "../../stubs/echo-files.mjs", "{files:repo_sources}"], "timeout_seconds": 5, "skip_if_empty": "repo_sources" }
    ],
    "full": [ { "name": "ok", "argv": ["node", "../../stubs/ok.mjs"], "timeout_seconds": 5 } ],
    "audit": []
  }
}
