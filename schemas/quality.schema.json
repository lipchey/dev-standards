{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-standards.local/quality.schema.json",
  "title": "quality.json — self-maintaining quality-system manifest (v1)",
  "description": "Per-repo manifest consumed by verify-runner. `version` is the MAJOR schema version (integer). This schema expresses structure, types, enums, and required keys; cross-field semantic rules (timeout-budget sums, fileset-reference integrity, argv shape, workflow reviewer-independence seat rule) are enforced by the runner's hand-written validator and listed in the design spec §6.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "repo", "stack", "scheduler_class", "budgets", "policy", "paths", "generated", "workspaces", "filesets", "tiers"],
  "properties": {
    "version": { "const": 1, "description": "MAJOR schema version. dev-standards supports the current major and the immediately previous major." },
    "repo": { "type": "string", "minLength": 1, "description": "Repository identifier." },
    "stack": { "enum": ["node-service", "frontend-web", "n8n-ops", "meta-docs"], "description": "Primary stack template. meta-docs = the self-maintaining-system planning repo (lightweight markdown/secret checks)." },
    "scheduler_class": { "enum": ["github-actions-push-and-schedule", "n8n-webhook-and-schedule", "schedule-only", "local-only"], "description": "Honest declaration of async/scheduled verification capability (plan §9)." },
    "budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["staged_seconds", "fast_seconds", "full_seconds", "audit_seconds"],
      "properties": {
        "staged_seconds": { "type": "integer", "exclusiveMinimum": 0 },
        "fast_seconds": { "type": "integer", "exclusiveMinimum": 0 },
        "full_seconds": { "type": "integer", "exclusiveMinimum": 0 },
        "audit_seconds": { "type": "integer", "exclusiveMinimum": 0 }
      },
      "description": "Hard wall-clock budgets per tier. The runner enforces sum(check timeout_seconds) <= the tier budget (see §6)."
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["mutates_by_default", "format_fix_staged_allowed", "typed_eslint_in_precommit", "block_new_dead_code_only"],
      "properties": {
        "mutates_by_default": { "type": "boolean" },
        "format_fix_staged_allowed": { "type": "boolean" },
        "typed_eslint_in_precommit": { "type": "boolean" },
        "block_new_dead_code_only": { "type": "boolean" }
      }
    },
    "paths": {
      "type": "object", "additionalProperties": false,
      "required": ["reports", "baselines"],
      "properties": {
        "reports": { "type": "string", "minLength": 1, "description": "Directory for generated reports; git-ignored." },
        "baselines": { "type": "string", "minLength": 1, "description": "Directory for committed baselines." }
      }
    },
    "generated": {
      "type": "object", "additionalProperties": false,
      "required": ["hooks_dir"],
      "properties": {
        "hooks_dir": { "type": "string", "minLength": 1, "description": "core.hooksPath target holding generated native git hooks." },
        "ci_quality": { "type": "string", "description": "Optional generated CI workflow path." }
      }
    },
    "workspaces": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "path", "stack", "package_manager"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "stack": { "enum": ["node-service", "frontend-web", "n8n-ops", "meta-docs"] },
          "package_manager": { "enum": ["npm", "pnpm", "yarn", "none"] }
        }
      }
    },
    "filesets": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "source", "include"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "source": { "enum": ["git_staged", "repo_all"], "description": "git_staged = `git diff --cached --name-only -z`; repo_all = `git ls-files -z`." },
          "include": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Restricted glob dialect: `**` (any depth), `*` (within one path segment), literal segments, `*.ext`. Other glob features (`?`, `[...]`, `{...}`) are rejected by the validator." },
          "exclude": { "type": "array", "items": { "type": "string" } },
          "diff_filter": { "type": "string", "pattern": "^[ACDMRTUXB]+$", "default": "ACMR", "description": "git --diff-filter letters; applies only to git_staged. Defaults to ACMR." }
        }
      }
    },
    "tiers": {
      "type": "object", "additionalProperties": false,
      "required": ["staged", "fast", "full"],
      "properties": {
        "staged": { "$ref": "#/$defs/checkArray" },
        "fast": { "$ref": "#/$defs/checkArray" },
        "full": { "$ref": "#/$defs/checkArray" },
        "audit": { "$ref": "#/$defs/checkArray" }
      }
    },
    "workflow": { "$ref": "#/$defs/workflow" },
    "deep_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "trigger": { "type": "string", "enum": ["manual-only"] },
        "modes": {
          "type": "array",
          "items": { "type": "string", "enum": ["review-only", "review-and-refactor"] }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["seconds"],
          "properties": {
            "seconds": { "type": "integer", "minimum": 1 },
            "tokens": { "type": ["integer", "null"], "minimum": 1 }
          }
        },
        "verify_after_fix": { "type": "string", "enum": ["--fast", "--full"] },
        "no_touch_globs_ref": { "type": "string", "minLength": 1 },
        "guides_dir": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "checkArray": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "argv", "timeout_seconds"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "argv": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Executed via spawnSync(file, args, {shell:false}). May contain at most one `{files:<fileset>}` token, expanded to N argv elements." },
          "timeout_seconds": { "type": "integer", "exclusiveMinimum": 0, "description": "Mandatory per-check timeout." },
          "skip_if_empty": { "type": "string", "description": "Fileset name; skip this check when that fileset expands to zero files." },
          "mode": { "enum": ["blocking", "report-only"], "default": "blocking" },
          "baseline": { "type": "string", "description": "Committed baseline path (baseline-diff semantics are out of pre-flight scope)." },
          "bypassable": { "type": "boolean", "default": false, "description": "Whether QUALITY_BYPASS_REASON may relax this check. Secret/credential checks must keep this false. Enforcement is out of pre-flight scope." }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional semi-automatic workflow layer (ADR-012). Absent, or `{\"enabled\": false}`, is valid. When `enabled` is true the full shape below is required. The cross-field seat rule (reviewer_independence vs agents argv[0]) is enforced only by the hand validator.",
      "required": ["enabled"],
      "properties": {
        "schema": { "const": 1, "description": "Workflow config schema version (integer 1)." },
        "enabled": { "type": "boolean", "description": "When true, every key below is required." },
        "base_branch": { "type": "string", "minLength": 1, "description": "Branch the workflow integrates into (e.g. main)." },
        "worktree_parent": { "type": "string", "minLength": 1, "description": "Directory under which per-task worktrees are created." },
        "cmux_mode": { "enum": ["manual", "auto"], "description": "Whether cmux orchestration runs manually or automatically." },
        "loopback_mode": { "enum": ["manual", "auto"], "description": "Whether review loopback runs manually or automatically." },
        "reviewer_independence": { "enum": ["different-runtime", "same-runtime"], "default": "different-runtime", "description": "different-runtime keeps the producer and reviewer on separate runtimes (ADR-008 seat split)." },
        "required_review_guides": { "type": "array", "items": { "type": "string" }, "description": "Review guides that must be applied; may be empty." },
        "commit_exclude": { "type": "array", "items": { "type": "string" }, "description": "Glob patterns excluded from workflow commits; may be empty." },
        "archive": { "type": "boolean", "description": "Whether completed worktrees/reports are archived." },
        "timeouts": {
          "type": "object", "additionalProperties": false,
          "required": ["default_wait_seconds", "default_work_seconds"],
          "properties": {
            "default_wait_seconds": { "type": "integer", "exclusiveMinimum": 0, "description": "Default seconds to wait for an external party." },
            "default_work_seconds": { "type": "integer", "exclusiveMinimum": 0, "description": "Default seconds allotted to a work step." }
          },
          "description": "Default per-step timeouts."
        },
        "budget": {
          "type": "object", "additionalProperties": false,
          "required": ["workflow_total_seconds"],
          "properties": {
            "workflow_total_seconds": { "type": "integer", "exclusiveMinimum": 0, "description": "Hard wall-clock budget for an entire workflow run." }
          },
          "description": "Whole-workflow wall-clock budget."
        },
        "agents": {
          "type": "object", "additionalProperties": false,
          "required": ["claude", "codex"],
          "properties": {
            "claude": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "argv for the Claude seat; argv[0] is the executable." },
            "codex": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "argv for the Codex seat; argv[0] is the executable." }
          },
          "description": "Per-seat agent invocations (argv). Under different-runtime, the two argv[0]s must differ (hand validator)."
        },
        "ship": {
          "type": "object", "additionalProperties": false,
          "required": ["ci_wait_seconds", "notify"],
          "properties": {
            "ci_wait_seconds": { "type": "integer", "exclusiveMinimum": 0, "description": "Seconds to wait for CI before shipping." },
            "notify": { "type": "boolean", "description": "Whether to send a notification on ship." }
          },
          "description": "Ship-step settings."
        },
        "notify": {
          "type": "object", "additionalProperties": false,
          "required": ["webhook_env"],
          "properties": {
            "webhook_env": { "type": "string", "minLength": 1, "pattern": "^[A-Z][A-Z0-9_]*$", "description": "Name of the env var holding the notification webhook URL." }
          },
          "description": "Notification settings."
        }
      },
      "if": {
        "properties": { "enabled": { "const": true } },
        "required": ["enabled"]
      },
      "then": {
        "required": [
          "schema",
          "enabled",
          "base_branch",
          "worktree_parent",
          "cmux_mode",
          "loopback_mode",
          "reviewer_independence",
          "required_review_guides",
          "commit_exclude",
          "archive",
          "timeouts",
          "budget",
          "agents",
          "ship",
          "notify"
        ]
      }
    }
  }
}
