#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(CDPATH= cd "$(dirname "$0")" && pwd -P)"
BUNDLE="${REPO_ROOT}/runner/dist/verify-runner.mjs"

if [[ ! -f "${BUNDLE}" ]]; then
  echo "verify-runner bundle not found at ${BUNDLE}. Run: npm run build" >&2
  exit 127
fi

exec node "${BUNDLE}" --manifest "${REPO_ROOT}/quality.json" "$@"
